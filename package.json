{
  "name": "@mrmartineau/lil-debugger",
  "version": "1.0.0",
  "description": "A tiny, framework-agnostic dev tool. Hold Ctrl+Shift to see the data-debug value of any element.",
  "keywords": [
    "data-attribute",
    "debug",
    "debugger",
    "devtools",
    "framework-agnostic"
  ],
  "homepage": "https://zander.wtf/lil-debugger",
  "bugs": {
    "url": "https://github.com/mrmartineau/lil-debugger/issues"
  },
  "license": "ISC",
  "author": {
    "name": "Zander Martineau",
    "email": "zander@zander.wtf",
    "url": "https://zander.wtf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmartineau/lil-debugger.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --target es2020 --dts --sourcemap --clean",
    "check": "vp check --fix",
    "dev": "tsdown src/index.ts --format cjs,esm --target es2020 --dts --sourcemap --watch",
    "prepare": "vp config",
    "release": "semantic-release",
    "test": "bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "happy-dom": "^20.14.5",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
